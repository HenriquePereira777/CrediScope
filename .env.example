# Copie este arquivo para ".env":   cp .env.example .env
# O ".env" NUNCA vai para o Git.
# Todas as variáveis começam com CREDISCOPE_ para não conflitar com outros projetos.

# ── Banco de dados (Docker) ─────────────────────────────
CREDISCOPE_DB_NAME=crediscope
CREDISCOPE_DB_USER=crediscope
CREDISCOPE_DB_PASSWORD=crediscope
# Porta no seu computador (5433 para não conflitar com um PostgreSQL local)
CREDISCOPE_DB_PORTA=5433

# ── Segurança ───────────────────────────────────────────
# Em produção, gere um valor aleatório com no mínimo 32 caracteres
CREDISCOPE_JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres
# true em produção (site em HTTPS). false para rodar em http://localhost
CREDISCOPE_COOKIE_SEGURO=false

# ── Frontend no Docker (docker compose up --build) ──────
CREDISCOPE_CORS_ORIGINS_DOCKER=http://localhost:8081

# ── Serasa ──────────────────────────────────────────────
# mock = dados fictícios (desenvolvimento) | api = Serasa real (precisa de contrato)
CREDISCOPE_SERASA_MODO=mock
CREDISCOPE_SERASA_BASE_URL=
CREDISCOPE_SERASA_CLIENT_ID=
CREDISCOPE_SERASA_CLIENT_SECRET=
