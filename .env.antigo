# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.

# Banco de dados
DB_NAME=crediscope
DB_USER=crediscope
DB_PASSWORD=crediscope

# Backend
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=gere-um-segredo-com-no-minimo-32-caracteres
CORS_ORIGINS=http://localhost:5173

# Serasa (mock = dados fictícios; api = Serasa real, precisa de contrato)
SERASA_MODO=mock
SERASA_BASE_URL=
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
